# Pick one provider: gemini (free tier), groq (free tier) or openai
LLM_PROVIDER=gemini

# Your API key for that provider. Never commit the real .env file.
LLM_API_KEY=

# Optional: override the default model for the provider
# gemini default: newest Flash model your key can use (found automatically) | groq default: llama-3.3-70b-versatile | openai default: gpt-4o-mini
LLM_MODEL=

# Leave LLM_API_KEY empty to run in demo mode with scripted replies (no AI calls).

# Optional: point to any other OpenAI-compatible API (for example https://openrouter.ai/api/v1)
LLM_BASE_URL=

# Practise with friends: on Vercel, rooms need shared storage. Create a free Upstash Redis
# database (upstash.com), copy its REST URL and token here. Locally you can leave these empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
